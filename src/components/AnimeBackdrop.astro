<div class="backdrop" data-backdrop aria-hidden="true">
  <div class="backdrop__media">
    <img class="backdrop__img" src="/images/summer/hero.jpg" alt="" width="1600" height="900" />
  </div>
  <span class="backdrop__veil"></span>
  <span class="backdrop__glow"></span>
  <span class="backdrop__stars">
    <i style="--x: 10%; --y: 18%; --d: 0s"></i>
    <i style="--x: 22%; --y: 9%; --d: .8s"></i>
    <i style="--x: 35%; --y: 24%; --d: 1.6s"></i>
    <i style="--x: 48%; --y: 13%; --d: .4s"></i>
    <i style="--x: 61%; --y: 28%; --d: 2.2s"></i>
    <i style="--x: 73%; --y: 11%; --d: 1.1s"></i>
    <i style="--x: 86%; --y: 21%; --d: 2.8s"></i>
    <i style="--x: 94%; --y: 7%; --d: 1.8s"></i>
    <i style="--x: 16%; --y: 33%; --d: 3.2s"></i>
    <i style="--x: 55%; --y: 37%; --d: 2.5s"></i>
  </span>
  <span class="backdrop__grain"></span>
</div>

<script is:inline>
  (() => {
    const backdrop = document.querySelector('[data-backdrop]');
    if (!backdrop) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.innerWidth < 720;
    let target = window.scrollY || 0;
    let current = target;
    let frame = 0;
    const update = () => {
      frame = 0;
      current += (target - current) * .12;
      backdrop.style.setProperty('--scroll', current.toFixed(1));
      if (Math.abs(target - current) > .5) frame = requestAnimationFrame(update);
    };
    if (!reduce) {
      window.addEventListener('scroll', () => {
        target = window.scrollY || 0;
        if (!frame) frame = requestAnimationFrame(update);
      }, { passive: true });
    }
    update();
  })();
</script>
