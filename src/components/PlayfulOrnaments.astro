<div class="ambient-layer" aria-hidden="true">
  <canvas class="ambient-canvas" data-ambient-canvas></canvas>
  <div class="ambient-ripples" data-ambient-ripples></div>
</div>

<script is:inline>
  (() => {
    const start = () => {
      const root = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const lowPower = (navigator.hardwareConcurrency ?? 8) <= 4;
      let pointerX = 0.5;
      let pointerY = 0.3;
      if (reduceMotion || lowPower) root.dataset.motion = 'reduced';

      const revealItems = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !reduceMotion) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting));
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }

      if (!reduceMotion && canHover && !lowPower) {
        let frame = 0;
        let x = 50;
        let y = 30;
        let clientX = window.innerWidth / 2;
        let clientY = window.innerHeight * .3;
        window.addEventListener('pointermove', (event) => {
          clientX = event.clientX;
          clientY = event.clientY;
          x = (clientX / window.innerWidth) * 100;
          y = (clientY / window.innerHeight) * 100;
          pointerX = x / 100;
          pointerY = y / 100;
          if (!frame) frame = requestAnimationFrame(() => {
            root.style.setProperty('--pointer-x', `${x}%`);
            root.style.setProperty('--pointer-y', `${y}%`);
            root.style.setProperty('--pointer-shift-x', `${(clientX - window.innerWidth / 2) * 0.08}px`);
            root.style.setProperty('--pointer-shift-y', `${(clientY - window.innerHeight / 2) * 0.06}px`);
            frame = 0;
          });
        }, { passive: true });
      }

      if (!reduceMotion && !lowPower) {
        const rippleLayer = document.querySelector('[data-ambient-ripples]');
        let rippleCount = 0;

        document.addEventListener('pointerdown', (event) => {
          if (!rippleLayer || rippleCount >= 3) return;
          rippleCount += 1;
          const ripple = document.createElement('span');
          ripple.className = 'ambient-ripple';
          ripple.style.left = `${event.clientX}px`;
          ripple.style.top = `${event.clientY}px`;
          rippleLayer.append(ripple);
          window.setTimeout(() => {
            ripple.remove();
            rippleCount = Math.max(0, rippleCount - 1);
          }, 850);
        }, { passive: true });
      }

      const canvas = document.querySelector('[data-ambient-canvas]');
      const reducedCanvas = reduceMotion || lowPower || !canHover || window.innerWidth <= 720 || window.matchMedia('(prefers-reduced-data: reduce)').matches;
      if (!(canvas instanceof HTMLCanvasElement) || reducedCanvas) return;

      const context = canvas.getContext('2d', { alpha: true, desynchronized: true });
      if (!context) return;

      const pointerRipples = [];
      const addCanvasRipple = (x, y, strength = 1) => {
        pointerRipples.push({ x, y, born: performance.now(), strength });
        if (pointerRipples.length > 6) pointerRipples.shift();
      };
      let lastPointerRipple = 0;
      let width = 0;
      let height = 0;
      let resizeFrame = 0;
      let animationFrame = 0;
      let lastFrame = 0;
      let active = !document.hidden;

      const resize = () => {
        resizeFrame = 0;
        const ratio = Math.min(window.devicePixelRatio || 1, 1.25);
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = Math.floor(width * ratio);
        canvas.height = Math.floor(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
      };

      const scheduleResize = () => {
        if (!resizeFrame) resizeFrame = requestAnimationFrame(resize);
      };

      const stop = () => {
        active = false;
        if (animationFrame) cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      };

      const start = () => {
        if (active || document.hidden) return;
        active = true;
        lastFrame = 0;
        animationFrame = requestAnimationFrame(draw);
      };

      const draw = (time) => {
        if (!active || document.hidden) return;
        animationFrame = requestAnimationFrame(draw);
        if (time - lastFrame < 34) return;
        lastFrame = time;
        context.clearRect(0, 0, width, height);

        const horizon = height * .38;
        const drawWave = (base, amplitude, length, speed, phase, color, lineWidth, alpha = 1, fillColor = '', fillDepth = 0) => {
          const drawPath = () => {
            context.beginPath();
            for (let x = -40; x <= width + 40; x += 18) {
              const progress = x / Math.max(width, 1);
              const primary = Math.sin(progress * length + time * speed + phase);
              const secondary = Math.sin(progress * length * 2.1 - time * speed * .62 + phase * 1.7) * .28;
              const pointerLift = Math.exp(-Math.pow((progress - pointerX) * 4.6, 2)) * (pointerY - .5) * 42;
              const y = base + primary * amplitude + secondary * amplitude + pointerLift;
              if (x === -40) context.moveTo(x, y);
              else context.lineTo(x, y);
            }
          };

          if (fillColor && fillDepth > 0) {
            drawPath();
            context.lineTo(width + 40, base + fillDepth);
            context.lineTo(-40, base + fillDepth);
            context.closePath();
            context.globalAlpha = alpha;
            context.fillStyle = fillColor;
            context.fill();
          }

          drawPath();
          context.globalAlpha = alpha;
          context.strokeStyle = color;
          context.lineWidth = lineWidth;
          context.lineCap = 'round';
          context.lineJoin = 'round';
          context.stroke();
          context.globalAlpha = 1;
        };

        drawWave(horizon - 34, 15, 11, .0009, .7, 'rgba(118, 174, 220, .2)', 1.2, .62, 'rgba(164, 216, 239, .08)', 20);
        drawWave(horizon + 6, 22, 8.5, .0011, 2.4, 'rgba(85, 151, 211, .3)', 1.8, .78, 'rgba(96, 176, 222, .11)', 28);
        drawWave(horizon + 78, 31, 7.2, .00125, 4.1, 'rgba(53, 129, 202, .32)', 2, .84, 'rgba(54, 142, 204, .13)', 34);
        drawWave(horizon + 164, 40, 5.8, .0014, 1.2, 'rgba(64, 145, 207, .38)', 2.4, .86, 'rgba(66, 153, 211, .15)', 42);
        drawWave(horizon + height * .38, 52, 4.8, .00155, 3.5, 'rgba(104, 176, 220, .26)', 2.6, .72, 'rgba(104, 177, 220, .1)', 54);

        const now = time;
        for (let index = pointerRipples.length - 1; index >= 0; index -= 1) {
          const ripple = pointerRipples[index];
          const age = now - ripple.born;
          if (age > 1500) {
            pointerRipples.splice(index, 1);
            continue;
          }
          const progress = age / 1500;
          const radius = 24 + progress * Math.min(width, height) * .28 * ripple.strength;
          const fade = (1 - progress) * .34;
          context.globalAlpha = fade;
          context.strokeStyle = 'rgba(83, 157, 216, 1)';
          context.lineWidth = 1.5;
          context.beginPath();
          context.ellipse(ripple.x, ripple.y, radius, radius * .28, 0, 0, Math.PI * 2);
          context.stroke();
          context.globalAlpha = 1;
        }
      };

      resize();
      const readPointer = () => {
        pointerX = (parseFloat(getComputedStyle(root).getPropertyValue('--pointer-x')) || 50) / 100;
        pointerY = (parseFloat(getComputedStyle(root).getPropertyValue('--pointer-y')) || 30) / 100;
      };
      readPointer();
      window.addEventListener('resize', scheduleResize, { passive: true });
      window.addEventListener('pointermove', (event) => {
        const now = performance.now();
        if (now - lastPointerRipple < 110) return;
        lastPointerRipple = now;
        addCanvasRipple(event.clientX, Math.max(event.clientY, height * .28), .42);
      }, { passive: true });
      window.addEventListener('pointerdown', (event) => {
        addCanvasRipple(event.clientX, event.clientY, 1.15);
      }, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });
      window.addEventListener('pagehide', stop, { once: true });
      if (active) animationFrame = requestAnimationFrame(draw);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
    else start();
  })();
</script>
