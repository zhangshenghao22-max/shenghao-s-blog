<div class="ambient-layer" aria-hidden="true">
  <canvas class="ambient-canvas" data-ambient-canvas></canvas>
</div>

<script is:inline>
  (() => {
    const boot = () => {
      const canvas = document.querySelector('[data-ambient-canvas]');
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reducedData = window.matchMedia('(prefers-reduced-data: reduce)').matches;
      const lowPower = (navigator.hardwareConcurrency ?? 8) <= 4;
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const context = canvas.getContext('2d', { alpha: true, desynchronized: true });
      if (!context) return;
      const revealItems = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !reduceMotion) {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting)), { threshold: .12, rootMargin: '0px 0px -8% 0px' });
        revealItems.forEach((item) => observer.observe(item));
      } else revealItems.forEach((item) => item.classList.add('is-visible'));

      const TAU = Math.PI * 2;
      let width = 0;
      let height = 0;
      let pixelSize = 3;
      let resizeFrame = 0;
      let animationFrame = 0;
      let lastFrame = 0;
      let active = false;
      let pointer = { x: -100, y: -100, moved: false };
      const ripples = [];
      const foamRemnants = Array.from({ length: 40 }, (_, index) => ({ seed: index * 13.71, x: (Math.sin(index * 8.13) * .5 + .5), offset: .05 + (index % 7) * .017 }));
      const sandMarks = Array.from({ length: 34 }, (_, index) => ({ seed: index * 17.22, x: Math.sin(index * 2.3) * .5 + .5, y: .72 + (Math.sin(index * 4.4) * .5 + .5) * .25 }));
      const birds = [
        { offset: .06, speed: .000035, phase: .2, scale: 1.15 },
        { offset: .55, speed: -.000025, phase: 2.5, scale: .85 },
        { offset: .86, speed: .000019, phase: 4.2, scale: .7 },
      ];
      const crabs = [
        { x: .19, offset: .12, direction: 1, speed: .000022, phase: .4, panic: 0 },
        { x: .57, offset: .18, direction: -1, speed: .000018, phase: 2.2, panic: 0 },
        { x: .84, offset: .1, direction: -1, speed: .000024, phase: 4.7, panic: 0 },
      ];

      const shoreY = (x, time, tide = 0) => height * (.49 + x * .23) + Math.sin(x * 8.4 + time * .00018) * 7 + Math.sin(x * 20 - time * .00027) * 2.5 + tide;
      const seaY = (x, time, distance) => shoreY(x, time) - distance + Math.sin(x * 16 - time * .00032) * 5;
      const resize = () => {
        resizeFrame = 0;
        pixelSize = window.innerWidth > 1100 ? 3 : 2;
        width = Math.ceil(window.innerWidth / pixelSize);
        height = Math.ceil(window.innerHeight / pixelSize);
        canvas.width = Math.max(1, width);
        canvas.height = Math.max(1, height);
        canvas.style.width = `${window.innerWidth}px`;
        canvas.style.height = `${window.innerHeight}px`;
      };
      const scheduleResize = () => { if (!resizeFrame) resizeFrame = requestAnimationFrame(resize); };
      const toWorld = (event) => ({ x: event.clientX / pixelSize, y: event.clientY / pixelSize });
      const addRipple = (event, strength = 1) => {
        const point = toWorld(event);
        if (ripples.length >= 4) ripples.shift();
        ripples.push({ x: point.x, y: point.y, born: performance.now(), strength });
        crabs.forEach((crab) => {
          const crabX = crab.x * width;
          const crabY = shoreY(crab.x, performance.now()) + crab.offset * height;
          if (Math.hypot(crabX - point.x, crabY - point.y) < width * .22) {
            crab.panic = performance.now() + 1300;
            crab.direction = crabX < point.x ? -1 : 1;
          }
        });
      };

      const fillScene = (time) => {
        const sky = context.createLinearGradient(0, 0, 0, height * .7);
        sky.addColorStop(0, '#c7eef2');
        sky.addColorStop(.45, '#84cfda');
        sky.addColorStop(1, '#258eaa');
        context.fillStyle = sky;
        context.fillRect(0, 0, width, height);
        const sand = context.createLinearGradient(0, height * .55, 0, height);
        sand.addColorStop(0, '#f7dfa9');
        sand.addColorStop(.55, '#e9c785');
        sand.addColorStop(1, '#c99862');
        context.fillStyle = sand;
        context.beginPath();
        context.moveTo(0, shoreY(0, time));
        for (let x = 0; x <= width; x += 4) context.lineTo(x, shoreY(x / width, time));
        context.lineTo(width, height);
        context.lineTo(0, height);
        context.closePath();
        context.fill();

        context.globalAlpha = .16;
        context.fillStyle = '#fff4ba';
        context.beginPath();
        context.arc(width * .82, height * .18, Math.max(14, width * .035), 0, TAU);
        context.fill();
        context.globalAlpha = .08;
        context.fillRect(width * .68, height * .18, width * .28, 2);
        context.globalAlpha = .06;
        context.fillRect(width * .58, height * .25, width * .38, 2);
        context.globalAlpha = 1;

        sandMarks.forEach((mark) => {
          const x = mark.x * width;
          const y = Math.max(shoreY(mark.x, time) + 24, mark.y * height);
          context.globalAlpha = .07 + (mark.seed % 3) * .015;
          context.fillStyle = mark.seed % 2 ? '#9e7048' : '#fff2c5';
          context.fillRect(x, y, 3 + (mark.seed % 6), 1);
          context.fillRect(x + 7, y + 2, 2, 1);
        });
        context.globalAlpha = 1;
      };

      const drawSeaTexture = (time) => {
        const bands = 7;
        for (let band = 0; band < bands; band += 1) {
          const distance = 38 + band * 34;
          const flow = time * (.008 + band * .001) + band * 46;
          for (let x = -40; x < width + 40; x += 7) {
            const drift = ((x + flow) % 86 + 86) % 86;
            if (drift > 34) continue;
            const progress = Math.max(0, Math.min(1, x / width));
            const y = seaY(progress, time, distance) + Math.sin(x * .05 + band) * 2;
            context.globalAlpha = .08 + (band % 3) * .018;
            context.fillStyle = band % 2 ? '#bff3ee' : '#076f91';
            context.fillRect(x, y, 10 + band, 1 + (band % 2));
            if (drift < 10) context.fillRect(x + 4, y + 2, 4, 1);
          }
        }
        context.globalAlpha = 1;
      };

      const drawBreaker = (time, distance, phase, opacity) => {
        const push = Math.sin(time * .00016 + phase) * 18 + Math.sin(time * .000065 + phase) * 10;
        for (let x = -8; x < width + 8; x += 5) {
          const progress = Math.max(0, Math.min(1, x / width));
          const y = shoreY(progress, time, push) - distance + Math.sin(progress * 19 + phase) * 3;
          const foam = (Math.sin(x * .045 - time * .00033 + phase) * .5 + .5) * opacity;
          context.globalAlpha = .1 + foam * .25;
          context.fillStyle = '#e6fbf4';
          context.fillRect(x, y, 3 + (x % 9), 1);
          if (foam > .4) context.fillRect(x + 2, y - 2, 2, 1);
        }
        context.globalAlpha = 1;
      };

      const drawWash = (time, tide) => {
        for (let pass = 0; pass < 3; pass += 1) {
          const push = tide + pass * 15;
          context.beginPath();
          context.moveTo(-8, shoreY(0, time, push));
          for (let x = 0; x <= width + 8; x += 4) context.lineTo(x, shoreY(x / width, time, push));
          for (let x = width + 8; x >= -8; x -= 4) context.lineTo(x, shoreY(x / width, time, push) + 4 + pass * 3);
          context.closePath();
          context.globalAlpha = [.28, .5, .23][pass];
          context.fillStyle = pass === 1 ? '#fffef0' : '#d9f6eb';
          context.fill();
        }
        context.globalAlpha = 1;
        foamRemnants.forEach((foam, index) => {
          const x = foam.x * width;
          const y = shoreY(foam.x, time, tide) + foam.offset * height;
          const drift = Math.sin(time * .00013 + foam.seed) * 4;
          context.globalAlpha = .12 + (index % 4) * .025;
          context.fillStyle = '#fffced';
          context.fillRect(x + drift, y, 5 + (index % 8), 2);
          if (index % 3 === 0) context.fillRect(x + drift + 8, y + 3, 3, 1);
        });
        context.globalAlpha = 1;
      };

      const drawBird = (bird, time) => {
        const path = (time * bird.speed + bird.offset) % 1;
        const x = (path * 1.24 - .12) * width;
        const y = height * (.13 + Math.sin(path * TAU * 1.7 + bird.phase) * .065) + Math.sin(time * .0007 + bird.phase) * 2;
        const s = bird.scale;
        const flap = Math.sin(time * .004 + bird.phase);
        context.save();
        context.translate(x, y);
        context.scale(s, s);
        context.globalAlpha = .16;
        context.fillStyle = '#397a87';
        context.fillRect(-9, 18, 18, 2);
        context.globalAlpha = .84;
        context.fillStyle = '#294e5b';
        context.fillRect(-2, -1, 6, 3);
        context.fillRect(4, -2, 3, 2);
        context.fillRect(7, -1, 2, 1);
        const wingY = flap > 0 ? -5 : -1;
        context.fillRect(-7, wingY, 5, 2);
        context.fillRect(-11, wingY - (flap > 0 ? 2 : -1), 4, 2);
        context.fillRect(-14, wingY - (flap > 0 ? 3 : -2), 3, 1);
        context.fillRect(8, wingY, 5, 2);
        context.fillRect(13, wingY - (flap > 0 ? 2 : -1), 4, 2);
        context.fillRect(17, wingY - (flap > 0 ? 3 : -2), 3, 1);
        context.fillStyle = '#efffff';
        context.fillRect(-4, 0, 4, 1);
        context.fillStyle = '#e9bf66';
        context.fillRect(9, -1, 2, 1);
        context.restore();
      };

      const drawCrab = (crab, time) => {
        const now = performance.now();
        const fleeing = crab.panic > now;
        const wobble = Math.sin(time * .003 + crab.phase) * .7;
        crab.x += crab.direction * (fleeing ? .00008 : crab.speed) * 42;
        if (crab.x < .04 || crab.x > .96) crab.direction *= -1;
        const x = crab.x * width;
        const y = shoreY(crab.x, time) + crab.offset * height + wobble;
        const step = Math.sin(time * .007 + crab.phase) > 0 ? 1 : -1;
        context.save();
        context.translate(x, y);
        context.globalAlpha = .28;
        context.fillStyle = '#704a37';
        context.fillRect(-8, 6, 17, 2);
        context.globalAlpha = .78;
          context.fillStyle = fleeing ? '#d56b4d' : '#a9543e';
          context.fillRect(-6, -3, 13, 7);
          context.fillRect(-4, -5, 9, 2);
          context.fillRect(-8, -4, 2, 3);
          context.fillRect(7, -4, 2, 3);
          context.fillStyle = '#663c38';
          context.fillRect(-3, -6, 2, 2);
          context.fillRect(3, -6, 2, 2);
          context.fillStyle = '#f4d68d';
          context.fillRect(-3, -4, 1, 1);
          context.fillRect(3, -4, 1, 1);
        context.strokeStyle = '#713c35';
        context.lineWidth = 1;
        for (let side = -1; side <= 1; side += 2) {
          context.beginPath();
          context.moveTo(side * 4, 0); context.lineTo(side * (10 + step), -5);
          context.moveTo(side * 4, 2); context.lineTo(side * (12 - step), 2);
          context.moveTo(side * 3, 3); context.lineTo(side * (9 + step), 8);
          context.stroke();
        }
        context.restore();
      };

      const drawRipples = (time) => {
        ripples.forEach((ripple, index) => {
          const progress = Math.min(1, (time - ripple.born) / 1500);
          if (progress >= 1) { ripples.splice(index, 1); return; }
          context.globalAlpha = (1 - progress) * .42;
          context.strokeStyle = '#effff7';
          context.lineWidth = 1;
          context.beginPath();
          context.ellipse(ripple.x, ripple.y, 8 + progress * 62, 3 + progress * 22, -.12, 0, TAU);
          context.stroke();
        });
        context.globalAlpha = 1;
      };

      const render = (time) => {
        const tide = Math.sin(time * .00016) * 10 + Math.sin(time * .00006) * 5;
        context.clearRect(0, 0, width, height);
        fillScene(time);
        drawSeaTexture(time);
        drawBreaker(time, 36, 1.1, .75);
        drawBreaker(time, 72, 3.6, .58);
        drawBreaker(time, 112, 5.4, .44);
        drawWash(time, tide);
        birds.forEach((bird) => drawBird(bird, time));
        crabs.forEach((crab) => drawCrab(crab, time));
        drawRipples(time);
      };
      const draw = (time) => {
        if (!active || document.hidden) return;
        if (time - lastFrame < 34) { animationFrame = requestAnimationFrame(draw); return; }
        lastFrame = time;
        render(time);
        animationFrame = requestAnimationFrame(draw);
      };
      const stop = () => { active = false; if (animationFrame) cancelAnimationFrame(animationFrame); animationFrame = 0; };
      const resume = () => { if (active || document.hidden) return; active = true; lastFrame = 0; animationFrame = requestAnimationFrame(draw); };

      resize();
      window.addEventListener('resize', scheduleResize, { passive: true });
      let lastHoverRipple = 0;
      window.addEventListener('pointermove', (event) => {
        pointer = toWorld(event);
        pointer.moved = true;
        const now = performance.now();
        if (now - lastHoverRipple > 220 && event.clientY < window.innerHeight * .7) {
          lastHoverRipple = now;
          addRipple(event, .24);
        }
      }, { passive: true });
      window.addEventListener('pointerdown', addRipple, { passive: true });
      document.addEventListener('visibilitychange', () => document.hidden ? stop() : resume());
      window.addEventListener('pagehide', stop, { once: true });
      const animate = !reduceMotion && !reducedData && !lowPower && canHover && window.innerWidth > 720;
      if (animate) { active = true; animationFrame = requestAnimationFrame(draw); }
      else { render(0); }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
    else boot();
  })();
</script>
