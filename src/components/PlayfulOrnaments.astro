<div class="ambient-layer" aria-hidden="true">
  <canvas class="ambient-canvas" data-ambient-canvas></canvas>
</div>

<script is:inline>
  (() => {
    const boot = () => {
      const canvas = document.querySelector('[data-ambient-canvas]');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reducedData = window.matchMedia('(prefers-reduced-data: reduce)').matches;
      const lowPower = (navigator.hardwareConcurrency ?? 8) <= 4;
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const context = canvas.getContext('2d', { alpha: true, desynchronized: true });
      if (!context) return;

      const revealItems = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !reduceMotion) {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting)), { threshold: .12, rootMargin: '0px 0px -8% 0px' });
        revealItems.forEach((item) => observer.observe(item));
      } else revealItems.forEach((item) => item.classList.add('is-visible'));

      const TAU = Math.PI * 2;
      let width = 0;
      let height = 0;
      let dpr = 1;
      let resizeFrame = 0;
      let animationFrame = 0;
      let lastFrame = 0;
      let active = false;
      let mobile = false;
      let pointer = { x: .5, y: .5, targetX: .5, targetY: .5, inside: false };
      const pulses = [];
      const dotFields = [];
      const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

      const resize = () => {
        resizeFrame = 0;
        width = Math.max(1, window.innerWidth);
        height = Math.max(1, window.innerHeight);
        dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        mobile = width < 720;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        context.imageSmoothingEnabled = false;
        pointer = { ...pointer, x: pointer.targetX, y: pointer.targetY };
        dotFields.length = 0;
        dotFields.push(
          { x: width * .84, y: height * .2, radius: Math.min(width * .26, height * .48), spacing: mobile ? 17 : 13, opacity: .42 },
          { x: width * .14, y: height * .95, radius: Math.min(width * .18, height * .22), spacing: mobile ? 20 : 15, opacity: .28 },
        );
      };
      const scheduleResize = () => {
        if (resizeFrame) return;
        resizeFrame = requestAnimationFrame(() => {
          resize();
          if (!active) render(0);
        });
      };
      const drawPolygon = (points, color, alpha) => {
        context.globalAlpha = alpha;
        context.fillStyle = color;
        context.beginPath();
        context.moveTo(points[0][0], points[0][1]);
        for (let index = 1; index < points.length; index += 1) context.lineTo(points[index][0], points[index][1]);
        context.closePath();
        context.fill();
      };

      const drawHalftone = (time) => {
        dotFields.forEach((field, fieldIndex) => {
          const spacing = field.spacing;
          const cols = Math.ceil(field.radius * 2 / spacing);
          const rows = Math.ceil(field.radius * 2 / spacing);
          const left = field.x - field.radius;
          const top = field.y - field.radius;
          for (let row = 0; row <= rows; row += 1) {
            for (let col = 0; col <= cols; col += 1) {
              const baseX = left + col * spacing;
              const baseY = top + row * spacing;
              const dx = (baseX - field.x) / field.radius;
              const dy = (baseY - field.y) / field.radius;
              const radial = dx * dx + dy * dy;
              if (radial > 1) continue;
              const pointerDistance = Math.hypot(baseX - pointer.x * width, baseY - pointer.y * height);
              const influence = pointer.inside ? Math.max(0, 1 - pointerDistance / (mobile ? 110 : 190)) : 0;
              const angle = Math.atan2(baseY - pointer.y * height, baseX - pointer.x * width);
              const offset = influence * (mobile ? 4 : 11);
              const wave = Math.sin(time * .0012 + row * .33 + col * .2 + fieldIndex) * (mobile ? 1 : 2.1);
              const x = baseX + Math.cos(angle) * offset + wave;
              const y = baseY + Math.sin(angle) * offset;
              const fade = (1 - radial) * field.opacity;
              const modulation = .72 + Math.sin(row * .61 + col * .27 + time * .00045) * .18;
              const radius = (1.05 + (1 - radial) * 1.15) * (mobile ? .78 : 1);
              context.globalAlpha = clamp(fade * modulation, 0, .46);
              context.fillStyle = (row + col + fieldIndex) % 9 === 0 ? '#09b8d0' : '#17212a';
              context.beginPath();
              context.arc(Math.round(x), Math.round(y), radius, 0, TAU);
              context.fill();
            }
          }
        });
        context.globalAlpha = 1;
      };

      const drawGeometry = (time) => {
        const shift = Math.sin(time * .00022) * (mobile ? 3 : 8);
        const px = (pointer.x - .5) * (pointer.inside ? 9 : 0);
        const py = (pointer.y - .5) * (pointer.inside ? 7 : 0);
        context.save();
        context.translate(px * .28, py * .28);
        drawPolygon([
          [width * .76 + shift, -height * .08], [width * 1.04, -height * .08],
          [width * 1.04, height * .57], [width * .93, height * .49], [width * .69, height * .18],
        ], '#111920', .1);
        drawPolygon([
          [width * .87 + shift, -height * .03], [width * 1.02, -height * .03],
          [width * 1.02, height * .39], [width * .96, height * .34],
        ], '#080d12', .13);
        drawPolygon([
          [-width * .08, height * .87], [width * .13, height * .78],
          [width * .31, height * 1.04], [-width * .08, height * 1.04],
        ], '#17212a', .065);
        drawPolygon([
          [width * .74 + shift, 0], [width * .755 + shift, 0],
          [width * .91, height * .38], [width * .89, height * .38],
        ], '#05b8d2', .42);
        drawPolygon([
          [0, height * .88], [width * .18, height * .79],
          [width * .185, height * .8], [0, height * .91],
        ], '#08a8c1', .34);
        context.restore();

        context.globalAlpha = .13;
        context.fillStyle = '#16212a';
        context.fillRect(width * .91, height * .53, width * .09, 1);
        context.fillRect(width * .95, height * .56, width * .05, 1);
        context.fillStyle = '#08b6cf';
        context.fillRect(width * .88, height * .54, width * .022, 2);
        context.fillRect(width * .06, height * .87, width * .045, 2);
        context.globalAlpha = 1;
      };

      const drawScan = (time) => {
        context.save();
        context.beginPath();
        context.moveTo(width * .68, 0);
        context.lineTo(width, 0);
        context.lineTo(width, height * .58);
        context.lineTo(width * .68, height * .18);
        context.closePath();
        context.clip();
        const phase = (time * .00008) % 1.4;
        const y = (phase - .2) * height;
        context.globalAlpha = .11;
        context.fillStyle = '#05b8d2';
        context.beginPath();
        context.moveTo(width * .68, y);
        context.lineTo(width, y - width * .17);
        context.lineTo(width, y - width * .13);
        context.lineTo(width * .68, y + height * .04);
        context.closePath();
        context.fill();
        context.restore();
        context.globalAlpha = 1;
      };

      const drawPulses = (time) => {
        for (let index = pulses.length - 1; index >= 0; index -= 1) {
          const pulse = pulses[index];
          const progress = (time - pulse.born) / 1050;
          if (progress >= 1) { pulses.splice(index, 1); continue; }
          const fade = (1 - progress) * .68;
          const radius = 18 + progress * Math.max(width, height) * .28;
          context.globalAlpha = fade;
          context.strokeStyle = '#05b9d2';
          context.lineWidth = 1.2;
          context.beginPath();
          context.arc(pulse.x, pulse.y, radius, 0, TAU);
          context.stroke();
          context.globalAlpha = fade * .35;
          context.lineWidth = 5;
          context.beginPath();
          context.arc(pulse.x, pulse.y, radius * .74, -.35, 1.05);
          context.stroke();
          context.globalAlpha = fade * .46;
          context.fillStyle = '#05b9d2';
          context.fillRect(pulse.x - 26, pulse.y - 1, 52, 2);
        }
        context.globalAlpha = 1;
      };

      const render = (time) => {
        pointer.x += (pointer.targetX - pointer.x) * .09;
        pointer.y += (pointer.targetY - pointer.y) * .09;
        context.clearRect(0, 0, width, height);
        context.fillStyle = '#fbfcff';
        context.fillRect(0, 0, width, height);
        drawGeometry(time);
        drawHalftone(time);
        drawScan(time);
        drawPulses(time);
      };
      const draw = (time) => {
        if (!active || document.hidden) return;
        const frameInterval = mobile || lowPower ? 48 : 32;
        if (time - lastFrame < frameInterval) { animationFrame = requestAnimationFrame(draw); return; }
        lastFrame = time;
        render(time);
        animationFrame = requestAnimationFrame(draw);
      };
      const stop = () => {
        active = false;
        if (animationFrame) cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      };
      const resume = () => {
        if (active || document.hidden || reduceMotion || reducedData || lowPower) return;
        active = true;
        lastFrame = 0;
        animationFrame = requestAnimationFrame(draw);
      };

      resize();
      window.addEventListener('resize', scheduleResize, { passive: true });
      const interactive = !reduceMotion && !reducedData && !lowPower;
      if (interactive && canHover) {
        window.addEventListener('pointermove', (event) => {
          pointer.targetX = clamp(event.clientX / width, 0, 1);
          pointer.targetY = clamp(event.clientY / height, 0, 1);
          pointer.inside = true;
        }, { passive: true });
        window.addEventListener('pointerleave', () => { pointer.inside = false; }, { passive: true });
      }
      if (interactive) {
        window.addEventListener('pointerdown', (event) => {
          if (pulses.length >= 3) pulses.shift();
          pulses.push({ x: event.clientX, y: event.clientY, born: performance.now() });
        }, { passive: true });
      }
      document.addEventListener('visibilitychange', () => document.hidden ? stop() : resume());
      window.addEventListener('pagehide', stop, { once: true });
      const animate = !reduceMotion && !reducedData && !lowPower;
      if (animate) {
        active = true;
        animationFrame = requestAnimationFrame(draw);
      } else {
        render(0);
      }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
    else boot();
  })();
</script>
