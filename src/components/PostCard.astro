---
import type { Diary } from '../lib/diary';
import { formatDate, getDiaryUrl } from '../lib/diary';

interface Props { diary: Diary; featured?: boolean }
const { diary, featured = false } = Astro.props;
const { title, pubDate, cover, coverAlt, description } = diary.data;
---

<article class:list={["diary-card", { "diary-card--featured": featured }]}>
  {cover && <a class="diary-card__media" href={getDiaryUrl(diary)} aria-label={`阅读《${title}》`}><img src={cover} alt={coverAlt ?? ''} loading={featured ? 'eager' : 'lazy'} /></a>}
  <div class="diary-card__body">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <h2><a href={getDiaryUrl(diary)}>{title}</a></h2>
    <p>{description}</p>
  </div>
</article>
