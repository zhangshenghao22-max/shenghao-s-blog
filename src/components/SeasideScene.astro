<div class="seaside" data-seaside aria-hidden="true">
  <div class="seaside__sky"></div>
  <div class="seaside__sun"><span class="sun__rays"></span></div>
  <div class="seaside__moon"></div>
  <div class="seaside__stars">
    <i style="--x: 8%; --y: 16%; --d: 0s"></i>
    <i style="--x: 18%; --y: 30%; --d: .8s"></i>
    <i style="--x: 29%; --y: 12%; --d: 1.6s"></i>
    <i style="--x: 41%; --y: 24%; --d: 2.4s"></i>
    <i style="--x: 54%; --y: 9%; --d: .4s"></i>
    <i style="--x: 66%; --y: 27%; --d: 1.2s"></i>
    <i style="--x: 76%; --y: 14%; --d: 2s"></i>
    <i style="--x: 88%; --y: 33%; --d: 2.8s"></i>
    <i style="--x: 94%; --y: 10%; --d: 1.4s"></i>
    <i style="--x: 36%; --y: 40%; --d: 3.2s"></i>
  </div>

  <div class="clouds clouds--far">
    <span class="cloud cloud--a"></span>
    <span class="cloud cloud--c"></span>
    <span class="cloud cloud--e"></span>
  </div>
  <div class="clouds clouds--near">
    <span class="cloud cloud--b"></span>
    <span class="cloud cloud--d"></span>
  </div>

  <div class="gulls">
    <svg class="gull gull--1" viewBox="0 0 60 20"><path d="M2 14C12 2 22 2 30 12C38 2 48 2 58 14" /></svg>
    <svg class="gull gull--2" viewBox="0 0 60 20"><path d="M2 14C12 2 22 2 30 12C38 2 48 2 58 14" /></svg>
    <svg class="gull gull--3" viewBox="0 0 60 20"><path d="M2 14C12 2 22 2 30 12C38 2 48 2 58 14" /></svg>
  </div>

  <div class="island">
    <span class="island__hill island__hill--1"></span>
    <span class="island__hill island__hill--2"></span>
    <span class="island__lighthouse"></span>
  </div>

  <div class="sea">
    <div class="sea__photo"></div>
    <div class="sea__glitter"></div>
    <svg class="wave wave--back" viewBox="0 0 2880 180" preserveAspectRatio="none">
      <path d="M0 92C240 32 480 152 720 92C960 32 1200 152 1440 92C1680 32 1920 152 2160 92C2400 32 2640 152 2880 92V180H0Z" />
    </svg>
    <svg class="wave wave--mid" viewBox="0 0 2880 160" preserveAspectRatio="none">
      <path d="M0 82C220 132 440 22 660 82C880 142 1100 22 1320 82C1540 142 1760 22 1980 82C2200 142 2420 22 2640 82C2760 112 2820 122 2880 102V160H0Z" />
    </svg>
    <svg class="wave wave--front" viewBox="0 0 2880 140" preserveAspectRatio="none">
      <path d="M0 86C260 126 520 36 780 86C1040 136 1300 36 1560 86C1820 136 2080 36 2340 86C2600 136 2740 106 2880 86V140H0Z" />
    </svg>
    <svg class="sea__lines" viewBox="0 0 1440 500" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-60 150C160 118 330 190 560 158S960 118 1180 160S1380 182 1500 150" vector-effect="non-scaling-stroke" />
      <path d="M-60 236C180 206 350 270 600 238S1000 202 1220 244S1400 268 1500 238" vector-effect="non-scaling-stroke" />
      <path d="M-60 324C200 292 380 360 620 326S1020 290 1240 330S1410 356 1500 326" vector-effect="non-scaling-stroke" />
      <path d="M-60 414C220 380 400 450 640 414S1040 378 1260 418S1420 446 1500 414" vector-effect="non-scaling-stroke" />
    </svg>
    <span class="boat"><span class="boat__sail"></span><span class="boat__hull"></span></span>
  </div>

  <div class="sand"><span class="sand__speckles"></span></div>
  <div class="shore">
    <svg viewBox="0 0 1440 70" preserveAspectRatio="none">
      <path d="M0 38C180 18 300 58 480 40C660 22 780 56 960 40C1140 24 1260 58 1440 36" />
    </svg>
  </div>

  <div class="props">
    <div class="umbrella"><span class="umbrella__canopy"></span><span class="umbrella__pole"></span></div>
    <div class="towel"></div>
    <div class="watermelon"><span class="watermelon__flesh"></span><i></i><i></i><i></i><i></i></div>
    <div class="flipflops"><span></span><span></span></div>
    <div class="shell shell--a"></div>
    <div class="shell shell--b"></div>
  </div>

  <div class="breeze"><i></i><i></i><i></i></div>
  <div class="seaside__grain"></div>
  <div class="seaside__halftone"></div>
</div>

<script is:inline>
  (() => {
    const scene = document.querySelector('[data-seaside]');
    if (!scene) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let target = window.scrollY || 0;
    let current = target;
    let frame = 0;

    const update = () => {
      frame = 0;
      current += (target - current) * .14;
      scene.style.setProperty('--scroll', current.toFixed(1));
      document.documentElement.classList.toggle('is-scrolled', current > window.innerHeight * .55);
      if (Math.abs(target - current) > .5) frame = requestAnimationFrame(update);
    };
    const onScroll = () => {
      target = window.scrollY || 0;
      if (!frame) frame = requestAnimationFrame(update);
    };

    if (!reduce) window.addEventListener('scroll', onScroll, { passive: true });
    update();

    if (!reduce && fine) {
      const sea = scene.querySelector('.sea');
      window.addEventListener('pointermove', (event) => {
        if (!sea) return;
        const rect = sea.getBoundingClientRect();
        const gx = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
        const gy = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
        sea.style.setProperty('--gx', `${(gx * 100).toFixed(1)}%`);
        sea.style.setProperty('--gy', `${(gy * 100).toFixed(1)}%`);
      }, { passive: true });
    }
  })();
</script>
