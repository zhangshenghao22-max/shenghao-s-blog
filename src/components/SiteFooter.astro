---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__postcard">
      <span class="site-footer__tape" aria-hidden="true"></span>
      <p class="site-footer__kicker">SEA MAIL / 海辺の郵便局</p>
      <p class="site-footer__name">清夏玖的个人网站</p>
      <p class="site-footer__note">夏天、海风，和一些不想忘记的事。</p>
      <span class="site-footer__stamp" aria-hidden="true">QXJ<br />2026</span>
    </div>

    <div class="site-footer__meta">
      <p>© {year} 清夏玖</p>
      <a class="site-footer__top" href="#top">回到岸上 <span aria-hidden="true">↑</span></a>
    </div>
  </div>
  <p class="site-footer__small">手绘场景 / CSS + SVG · 没有使用第三方插画</p>
  <span class="bottle" aria-hidden="true"><span class="bottle__note"></span></span>
</footer>
