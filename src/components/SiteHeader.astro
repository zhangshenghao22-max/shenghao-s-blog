---
const navItems = [
  { href: '/', label: '首页', en: 'HOME', index: '01' },
  { href: '/about/', label: '档案', en: 'PROFILE', index: '02' },
  { href: '/memories/', label: '记忆', en: 'MEMORY', index: '03' },
  { href: '/diary/', label: '日志', en: 'LOG', index: '04' },
];
const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="site-header">
  <a class="skip-link" href="#content">跳到正文</a>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="清夏玖的个人网站首页">
      <span class="brand__mark" aria-hidden="true"><span>清</span></span>
      <span class="brand__name">
        <b>清夏玖</b>
        <small>PERSONAL ARCHIVE</small>
      </span>
    </a>
    <nav class="nav" aria-label="主导航">
      {navItems.map((item) => (
        <a
          class:list={['nav__link', { 'is-active': isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <small class="nav__index">{item.index}</small>
          <span class="nav__cn">{item.label}</span>
          <em class="nav__en">{item.en}</em>
        </a>
      ))}
    </nav>
    <div class="site-header__status">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="status-label">SYSTEM ONLINE</span>
      <time class="status-clock" data-clock>--:--:--</time>
    </div>
  </div>
</header>
