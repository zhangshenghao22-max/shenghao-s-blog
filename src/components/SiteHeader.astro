---
const navItems = [
  { href: '/', label: '首页' },
  { href: '/about/', label: '我是谁？' },
  { href: '/memories/', label: '与你分享的记忆' },
  { href: '/diary/', label: '日日不记' },
];
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="skip-link" href="#content">跳到正文</a>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="清夏玖的个人网站首页">
      <span class="brand__mark" aria-hidden="true">清</span>
      <span class="brand__name">清夏玖</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {navItems.map((item) => (
        <a class:list={[{ 'is-active': item.href === '/' ? pathname === '/' : pathname.startsWith(item.href) }, 'nav__link']} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
