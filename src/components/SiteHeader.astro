---
const navItems = [
  { href: '/', label: '首页' },
  { href: '/#life', label: '生活' },
  { href: '/#tech', label: '技术' },
  { href: '/menu/', label: '入口' },
  { href: '/about/', label: '关于' },
];
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="skip-link" href="#content">跳到正文</a>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="日光微屿首页">
      <span class="brand__mark" aria-hidden="true">☺</span>
      <span>
        <span class="brand__name">日光微屿</span>
        <span class="brand__tagline">Soft life, bright code</span>
      </span>
    </a>
    <nav class="nav" aria-label="主导航">
      {navItems.map((item) => (
        <a class:list={[{ 'is-active': item.href === '/' ? pathname === '/' : pathname.startsWith(item.href.replace('/#', '/')) && item.href.startsWith('/') && !item.href.includes('#') }, 'nav__link']} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
