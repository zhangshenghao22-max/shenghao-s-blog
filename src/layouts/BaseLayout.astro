---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PlayfulOrnaments from '../components/PlayfulOrnaments.astro';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const siteName = '清夏玖的博客';
const defaultDescription = '清夏玖的高级沉浸式私人档案终端，记录生活档案、技术文章、灵感实验和个人简介。';
const { title, description = defaultDescription, pageClass = '' } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · Private Archive Terminal`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body class={pageClass}>
    <div class="soft-stage" aria-hidden="true">
      <span class="glow glow--peach"></span>
      <span class="glow glow--blue"></span>
      <span class="glow glow--mint"></span>
    </div>
    <PlayfulOrnaments />
    <SiteHeader />
    <main id="content" class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
