---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const siteName = '日光微屿';
const defaultDescription = '一个简约明朗的个人博客，分享生活记录、技术文章、灵感收藏和个人简介。';
const { title, description = defaultDescription, pageClass = '' } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · Life & Tech Blog`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8ef" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body class={pageClass}>
    <div class="soft-stage" aria-hidden="true">
      <span class="glow glow--peach"></span>
      <span class="glow glow--blue"></span>
      <span class="glow glow--mint"></span>
      <span class="floaty floaty--one">✦</span>
      <span class="floaty floaty--two">♡</span>
      <span class="floaty floaty--three">•</span>
    </div>
    <SiteHeader />
    <main id="content" class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
