---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PlayfulOrnaments from '../components/PlayfulOrnaments.astro';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const siteName = '清夏玖的个人网站';
const defaultDescription = '清夏玖的个人网站，分享生活、记忆和日常。';
const { title, description = defaultDescription, pageClass = '' } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfcff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body class={pageClass}>
    <PlayfulOrnaments />
    <SiteHeader />
    <main id="content" class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
