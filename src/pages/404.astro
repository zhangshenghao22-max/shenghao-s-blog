---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="迷路了" description="没有找到这个页面。" pageClass="error-page">
  <section class="error-sheet section-shell">
    <span class="chapter">A LOST PAGE / 404</span>
    <h1>迷路了</h1>
    <p class="hand">海鸥把这一页叼走了。</p>
    <p class="error-sheet__text">没有找到这个页面。它可能被海浪冲走，也可能从来没有被写下。</p>
    <a class="btn btn--sun" href="/">回到海边 <span aria-hidden="true">→</span></a>
    <span class="error-sheet__gull" aria-hidden="true"></span>
  </section>
</BaseLayout>
