---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryLabels, formatPostDate, getPostUrl, getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const groupedPosts = posts.reduce<Record<string, typeof posts>>((groups, post) => {
  const year = String(post.data.pubDate.getFullYear());
  groups[year] ??= [];
  groups[year].push(post);
  return groups;
}, {});
---

<BaseLayout title="归档" description="清夏玖的博客的所有生活和技术文章归档。">
  <section class="page-hero section-shell reveal">
    <p class="eyebrow">ARCHIVE INDEX</p>
    <h1>所有文章</h1>
    <p>把生活档案和技术记录按时间收好，方便快速检索每一次记录。</p>
  </section>

  <section class="archive section-shell">
    {Object.entries(groupedPosts).map(([year, yearPosts]) => (
      <div class="archive-year reveal">
        <h2>{year}</h2>
        <ol class="archive-list">
          {yearPosts.map((post) => (
            <li>
              <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
              <a href={getPostUrl(post)}>{post.data.title}</a>
              <span>{categoryLabels[post.data.category]}</span>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</BaseLayout>
