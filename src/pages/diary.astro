---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedDiaries } from '../lib/diary';
const diaries = await getPublishedDiaries();
---

<BaseLayout title="日日不记" description="清夏玖偶尔写下的日常。" pageClass="diary-page">
  <section class="page-heading section-shell reveal">
    <p class="ak-eyebrow">Log Archive / 002</p>
    <h1>日日不记</h1>
    <p>偶尔写下，慢慢收藏。</p>
    <a class="text-link" href="/admin/">写日记 <span aria-hidden="true">↗</span></a>
  </section>
  <section class="section-shell section-space diary-grid" aria-label="日记列表">
    {diaries.length ? diaries.map((diary, index) => (
      <div class="reveal diary-grid__item">
        <PostCard diary={diary} featured={index === 0} />
      </div>
    )) : (
      <div class="ak-empty">
        <span class="ak-empty__code">NO RECORDS / 000</span>
        <p>还没有写下的日记。</p>
        <a class="ak-btn ak-btn--sm" href="/admin/">写下第一篇 <span aria-hidden="true">→</span></a>
      </div>
    )}
  </section>
</BaseLayout>
