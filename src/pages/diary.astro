---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedDiaries } from '../lib/diary';
const diaries = await getPublishedDiaries();
---

<BaseLayout title="日日不记" description="清夏玖偶尔写下的日常。" pageClass="diary-page">
  <section class="page-head section-shell reveal">
    <span class="chapter">CHAPTER 04 / DIARY</span>
    <h1>日日不记</h1>
    <p class="hand page-head__note">偶尔写下，慢慢收藏。</p>
    <span class="page-head__stamp" aria-hidden="true">SEASIDE JOURNAL</span>
  </section>
  <section class="section-shell section-space diary-grid" aria-label="日记列表">
    {diaries.length ? diaries.map((diary, index) => (
      <div class="reveal diary-grid__item">
        <PostCard diary={diary} featured={index === 0} />
      </div>
    )) : (
      <div class="empty-letter">
        <span class="hand">这个夏天还没有写下什么。</span>
        <p>等一页纸被海风翻开。</p>
      </div>
    )}
  </section>
</BaseLayout>
