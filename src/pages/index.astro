---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedDiaries } from '../lib/diary';
import { getPublishedMemories, formatMemoryDate } from '../lib/memories';

const diaries = await getPublishedDiaries();
const memories = await getPublishedMemories();
const latestMemory = memories[0];
---

<BaseLayout pageClass="home-page">
  <div class="terminal-shell">
    <section class="terminal-hero section-shell" aria-labelledby="welcome-title">
      <div class="terminal-hero__copy reveal">
        <div class="terminal-hero__seal" aria-hidden="true"><span>清</span></div>
        <h1 id="welcome-title">欢迎来到清夏玖的个人网站</h1>
        <p>记录生活，也分享记忆。</p>
        <div class="terminal-actions">
          <a class="terminal-button terminal-button--primary" href="/about/">我是谁？ <span aria-hidden="true">↗</span></a>
          <a class="terminal-button terminal-button--quiet" href="/diary/">进入日日不记 <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="terminal-core reveal" aria-hidden="true">
        <div class="terminal-core__rings"><span></span><span></span><span></span></div>
        <div class="terminal-core__beam"></div>
        <div class="terminal-core__node"></div>
        <span class="terminal-core__orbit terminal-core__orbit--one"></span>
        <span class="terminal-core__orbit terminal-core__orbit--two"></span>
      </div>
      <div class="terminal-hero__rail" aria-hidden="true"></div>
    </section>

    <section id="explore" class="terminal-index section-shell" aria-labelledby="index-title">
      <div class="terminal-section-title reveal">
        <span class="terminal-section-title__line" aria-hidden="true"></span>
        <h2 id="index-title">从这里开始</h2>
      </div>
      <div class="terminal-index__grid">
        <a class="terminal-module terminal-module--profile reveal" href="/about/">
          <span class="terminal-module__shape" aria-hidden="true"></span>
          <strong>我是谁？</strong>
          <span class="terminal-module__arrow" aria-hidden="true">↗</span>
        </a>
        <a class="terminal-module terminal-module--memory reveal" href="/memories/">
          <span class="terminal-module__shape" aria-hidden="true"></span>
          <strong>与你分享的记忆</strong>
          <span class="terminal-module__arrow" aria-hidden="true">↗</span>
        </a>
        <a class="terminal-module terminal-module--diary reveal" href="/diary/">
          <span class="terminal-module__shape" aria-hidden="true"></span>
          <strong>日日不记</strong>
          <span class="terminal-module__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    {diaries.length > 0 && <section class="terminal-records section-shell section-space" aria-labelledby="records-title">
      <div class="terminal-section-title terminal-section-title--split reveal">
        <div><span class="terminal-section-title__line" aria-hidden="true"></span><h2 id="records-title">最近写下</h2></div>
        <a class="terminal-link" href="/diary/">查看全部 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="terminal-records__grid">
        {diaries.slice(0, 2).map((diary, index) => <div class="reveal"><PostCard diary={diary} featured={index === 0} /></div>)}
      </div>
    </section>}

    {latestMemory && <section class="terminal-memory section-shell section-space reveal" aria-labelledby="memory-title">
      <a class="terminal-memory__image" href="/memories/">
        {latestMemory.data.cover && <img src={latestMemory.data.cover} alt={latestMemory.data.coverAlt ?? ''} loading="lazy" />}
        <span class="terminal-memory__corner" aria-hidden="true"></span>
      </a>
      <div class="terminal-memory__copy">
        <time datetime={latestMemory.data.date.toISOString()}>{formatMemoryDate(latestMemory.data.date)}</time>
        <h2 id="memory-title">{latestMemory.data.title}</h2>
        <p>{latestMemory.data.description}</p>
        <a class="terminal-link" href="/memories/">打开记忆 <span aria-hidden="true">↗</span></a>
      </div>
    </section>}
  </div>
</BaseLayout>
