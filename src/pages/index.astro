---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const [latestPost, ...morePosts] = posts;
const signalStats = [
  { value: '03', label: '技术笔记' },
  { value: '42ms', label: '灵感延迟' },
  { value: '∞', label: '探索半径' },
];
---

<BaseLayout>
  <section class="hero section-shell">
    <div class="hero__copy reveal">
      <p class="eyebrow">Deep Space Tech Log</p>
      <h1>在星际噪声里，记录可运行的工程信号。</h1>
      <p class="hero__lead">
        这里收集前端实验、系统设计、开发工具链和 AI 时代的工程思考。把复杂问题拆成清晰轨道，让每次实践都留下可复用的坐标。
      </p>
      <div class="hero__actions">
        <a class="button" href="/archive/">进入知识星图</a>
        <a class="button button--ghost" href="/about/">查看任务档案</a>
      </div>
    </div>
    <aside class="hero__console reveal" aria-label="任务控制台">
      <div class="console-topline">
        <span></span><span></span><span></span>
      </div>
      <p class="hero__console-title">Mission Console</p>
      <code>boot: astro-blog</code>
      <code>theme: cosmic-tech</code>
      <code>status: publishing</code>
      <div class="radar" aria-hidden="true"><span></span></div>
    </aside>
  </section>

  <section class="section-shell signal-strip reveal" aria-label="博客状态">
    {signalStats.map((stat) => (
      <div>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </div>
    ))}
  </section>

  <section class="section-shell section-heading reveal">
    <p class="eyebrow">Latest Transmissions</p>
    <h2>最新传输</h2>
  </section>

  {latestPost ? (
    <section class="section-shell posts-showcase">
      <PostCard post={latestPost} featured />
      <div class="posts-grid">
        {morePosts.slice(0, 4).map((post) => <PostCard post={post} />)}
      </div>
    </section>
  ) : (
    <section class="section-shell empty-state">
      <p>还没有文章。稍后在 <code>src/content/posts/</code> 中写下第一篇吧。</p>
    </section>
  )}
</BaseLayout>
