---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDiaryUrl, getPublishedDiaries } from '../lib/diary';
import { getPublishedMemories } from '../lib/memories';

const diaries = await getPublishedDiaries();
const memories = await getPublishedMemories();
const latestDiary = diaries[0];
const latestMemory = memories[0];

const shortDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
const latestLogDate = latestDiary ? shortDate(latestDiary.data.pubDate) : 'NO RECORD';
const latestMemoDate = latestMemory ? shortDate(latestMemory.data.date) : 'NO RECORD';
const logCount = String(diaries.length).padStart(2, '0');
const memoCount = String(memories.length).padStart(2, '0');
---

<BaseLayout pageClass="home-page">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <img src="/images/summer/hero.jpg" alt="" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <span class="hero__shade" aria-hidden="true"></span>
    <span class="hero__flare" aria-hidden="true"></span>
    <span class="hero__grain" aria-hidden="true"></span>
    <span class="hero__frame" aria-hidden="true"></span>

    <div class="hero__copy">
      <p class="hero__kicker">SEASIDE SUMMER / 2026</p>
      <h1 id="hero-title">
        <span>清夏玖的个人网站</span>
        <em>QING XIA JIU · PERSONAL ARCHIVE</em>
      </h1>
      <p class="hero__lead">记录生活，也分享记忆。</p>
      <p class="hero__hand">今年夏天，也一起看海吧。</p>
      <div class="hero__actions">
        <a class="btn btn--light" href="#modules">走进海边 <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/about/">我是谁？</a>
      </div>
    </div>

    <p class="hero__vertical" aria-hidden="true">海辺の夏、忘れない。</p>
    <div class="hero__meta" aria-hidden="true">
      <span>35.3°N / 139.5°E</span>
      <span>晴 / 30°C</span>
    </div>
    <a class="hero__scroll" href="#modules"><span>SCROLL</span><i aria-hidden="true"></i></a>
  </section>

  <div class="film-ticker" aria-hidden="true">
    <div class="film-ticker__track">
      <span>海辺の夏 <i>·</i> SUMMER ARCHIVE <i>·</i> 蝉の声 <i>·</i> 青い海 <i>·</i> 風の通り道 <i>·</i> 夕凪 <i>·</i> 海辺の夏 <i>·</i> SUMMER ARCHIVE <i>·</i> 蝉の声 <i>·</i> 青い海 <i>·</i></span>
      <span>海辺の夏 <i>·</i> SUMMER ARCHIVE <i>·</i> 蝉の声 <i>·</i> 青い海 <i>·</i> 風の通り道 <i>·</i> 夕凪 <i>·</i> 海辺の夏 <i>·</i> SUMMER ARCHIVE <i>·</i> 蝉の声 <i>·</i> 青い海 <i>·</i></span>
    </div>
  </div>

  <section id="modules" class="scene-section" aria-labelledby="modules-title">
    <header class="section-head reveal">
      <span class="section-head__no">01</span>
      <div>
        <p class="section-head__en">Access / Modules</p>
        <h2 id="modules-title">个人终端</h2>
      </div>
      <span class="section-head__line" aria-hidden="true"></span>
      <span class="section-head__meta">03</span>
    </header>

    <nav class="portals" aria-label="个人网站入口">
      <a class="portal reveal" href="/about/">
        <span class="portal__no">01</span>
        <span class="portal__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48"><rect x="7" y="12" width="34" height="24" rx="2" /><circle cx="18" cy="23" r="4" /><path d="M11 32c1.4-4 12-4 14 0M30 22h7M30 28h7" /></svg>
        </span>
        <b>我是谁？</b>
        <em>Profile / 档案</em>
        <span class="portal__desc">关于我、番剧和游戏</span>
        <span class="portal__arrow" aria-hidden="true">→</span>
      </a>

      <a class="portal reveal" href="/memories/">
        <span class="portal__no">02</span>
        <span class="portal__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48"><rect x="7" y="15" width="34" height="22" rx="2" /><circle cx="24" cy="26" r="6" /><path d="M15 15l3-5h12l3 5" /><circle cx="35" cy="21" r="1.6" /></svg>
        </span>
        <b>与你分享的记忆</b>
        <em>Memory / 记忆</em>
        <span class="portal__desc">照片、视频和舍不得忘记的瞬间</span>
        <span class="portal__arrow" aria-hidden="true">→</span>
      </a>

      <a class="portal reveal" href="/diary/">
        <span class="portal__no">03</span>
        <span class="portal__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M12 7h20l5 5v29H12z" /><path d="M18 17h14M18 23h14M18 29h9" /></svg>
        </span>
        <b>日日不记</b>
        <em>Diary / 日志</em>
        <span class="portal__desc">偶尔写下，慢慢收藏</span>
        <span class="portal__arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </section>

  <section class="scene-section" aria-labelledby="latest-title">
    <header class="section-head reveal">
      <span class="section-head__no">02</span>
      <div>
        <p class="section-head__en">Recent / Log</p>
        <h2 id="latest-title">最近写下</h2>
      </div>
      <span class="section-head__line" aria-hidden="true"></span>
      <span class="section-head__meta">{logCount}</span>
    </header>

    {latestDiary ? (
      <article class="log-panel reveal">
        <div class="log-panel__media">
          {latestDiary.data.cover ? (
            <img src={latestDiary.data.cover} alt={latestDiary.data.coverAlt ?? ''} loading="lazy" />
          ) : (
            <span class="log-panel__blank" aria-hidden="true"><b>LOG</b><small>NO VISUAL</small></span>
          )}
        </div>
        <div class="log-panel__body">
          <div class="log-panel__meta">
            <time datetime={latestDiary.data.pubDate.toISOString()}>{latestLogDate}</time>
            <span>Entry / 001</span>
          </div>
          <h3><a href={getDiaryUrl(latestDiary)}>{latestDiary.data.title}</a></h3>
          <p>{latestDiary.data.description}</p>
          <div class="log-panel__foot">
            <div class="tags">
              {latestDiary.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
            <a class="link-arrow" href={getDiaryUrl(latestDiary)}>阅读全文 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </article>
    ) : (
      <div class="empty-panel reveal">
        <span class="empty-panel__mark" aria-hidden="true">NO RECORD</span>
        <p class="empty-panel__jp" aria-hidden="true">まだ、何も書いていない。</p>
        <h3>这个夏天，还没有写下什么。</h3>
        <p>有些日子先留白，等海风慢慢把它填满。</p>
        <a class="link-arrow" href="/diary/">去日记本看看 <span aria-hidden="true">→</span></a>
      </div>
    )}
  </section>

  <section class="scene-section" aria-labelledby="memory-title">
    <header class="section-head reveal">
      <span class="section-head__no">03</span>
      <div>
        <p class="section-head__en">Memory / Archive</p>
        <h2 id="memory-title">与你分享的记忆</h2>
      </div>
      <span class="section-head__line" aria-hidden="true"></span>
      <span class="section-head__meta">{memoCount}</span>
    </header>

    {latestMemory ? (
      <a class="memory-banner reveal" href="/memories/">
        <img
          src={latestMemory.data.cover ?? '/memories/assets/ocean-backdrop.jpg'}
          alt={latestMemory.data.coverAlt ?? latestMemory.data.title}
          loading="lazy"
        />
        <span class="memory-banner__shade" aria-hidden="true"></span>
        <div class="memory-banner__copy">
          <span class="tag">Memory / 001 · {latestMemoDate}</span>
          <h3>{latestMemory.data.title}</h3>
          <p>{latestMemory.data.description}</p>
          <span class="memory-banner__link">打开记忆 <span aria-hidden="true">→</span></span>
        </div>
        <span class="memory-banner__index" aria-hidden="true">M-001</span>
      </a>
    ) : (
      <div class="empty-panel reveal">
        <span class="empty-panel__mark" aria-hidden="true">NO MEMORY</span>
        <p class="empty-panel__jp" aria-hidden="true">まだ、写真がない。</p>
        <h3>还没有收藏的记忆。</h3>
      </div>
    )}
  </section>
</BaseLayout>
