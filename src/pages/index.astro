---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedDiaries } from '../lib/diary';
import { getPublishedMemories, formatMemoryDate } from '../lib/memories';

const diaries = await getPublishedDiaries();
const memories = await getPublishedMemories();
const latestMemory = memories[0];
---

<BaseLayout pageClass="home-page">
  <section class="home-hero section-shell">
    <div class="home-hero__backdrop" aria-hidden="true"><img src="/memories/assets/ocean-backdrop.jpg" alt="" /></div>
    <div class="home-hero__copy reveal">
      <h1>欢迎来到清夏玖的个人网站</h1>
      <p>清夏玖，记录生活，也分享记忆。</p>
      <a class="hero-link" href="#explore">向下看看 <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section id="explore" class="section-shell entrance-section">
    <div class="entrance-grid">
      <a class="entrance entrance--about reveal" href="/about/">
        <span class="entrance__doodle" aria-hidden="true">✳</span>
        <div><h2>我是谁？</h2><p>清夏玖 · 20岁 · 工科生</p></div>
        <span class="entrance__arrow" aria-hidden="true">↗</span>
      </a>
      <a class="entrance entrance--memories reveal" href="/memories/">
        <div class="entrance__photo-stack" aria-hidden="true"><img src="/memories/assets/profile-memory.webp" alt="" /><img src="/memories/assets/profile-memory.webp" alt="" /></div>
        <div><h2>与你分享的记忆</h2><p>一些舍不得忘记的瞬间。</p></div>
        <span class="entrance__arrow" aria-hidden="true">↗</span>
      </a>
      <a class="entrance entrance--diary reveal" href="/diary/">
        <div class="entrance__paper" aria-hidden="true"><span></span><span></span><span></span></div>
        <div><h2>日日不记</h2><p>偶尔写下，慢慢收藏。</p></div>
        <span class="entrance__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  {diaries.length > 0 && <section class="section-shell home-latest section-space">
    <div class="section-heading reveal"><h2>最近写下</h2><a href="/diary/" class="text-link">日日不记 <span aria-hidden="true">↗</span></a></div>
    <div class="diary-grid">
      {diaries.slice(0, 2).map((diary, index) => <div class="reveal"><PostCard diary={diary} featured={index === 0} /></div>)}
    </div>
  </section>}

  {latestMemory && <section class="section-shell memory-preview section-space reveal">
    <a class="memory-preview__image" href="/memories/">{latestMemory.data.cover && <img src={latestMemory.data.cover} alt={latestMemory.data.coverAlt ?? ''} loading="lazy" />}</a>
    <div class="memory-preview__copy"><time datetime={latestMemory.data.date.toISOString()}>{formatMemoryDate(latestMemory.data.date)}</time><h2>{latestMemory.data.title}</h2><p>{latestMemory.data.description}</p><a class="text-link" href="/memories/">与你分享的记忆 <span aria-hidden="true">↗</span></a></div>
  </section>}
</BaseLayout>
