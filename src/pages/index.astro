---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const [latestPost, ...morePosts] = posts;
const signalStats = [
  { value: '03', label: '技术传输' },
  { value: '06', label: '星图入口' },
  { value: '∞', label: '探索半径' },
];
const menuCards = [
  { href: '/archive/', label: '技术文章', title: 'Transmission Archive', text: 'Astro、工程化、界面实验与 AI Coding 的长期记录。', status: 'online' },
  { href: '#projects', label: '项目舱', title: 'Project Dock', text: '收纳可展示的项目、组件实验和正在孵化的想法。', status: 'build' },
  { href: '#signals', label: '灵感信号', title: 'Signal Radio', text: '随机灵感、设计片段、工具观察和短笔记。', status: 'live' },
  { href: '/about/', label: '任务档案', title: 'Mission Profile', text: '关于这个博客、技术关注点和联系方式。', status: 'stable' },
];
const projects = [
  { name: 'Cosmic Astro Blog', type: 'Static Site', text: '当前站点的宇宙科技主题，使用 Astro、Markdown 和 GitHub Pages。' },
  { name: 'UI Motion Lab', type: 'Design System', text: '准备沉淀卡片扫描光、星图菜单、深空玻璃面板等可复用动效。' },
  { name: 'AI Coding Notes', type: 'Workflow', text: '记录 AI 辅助开发中的提示词、重构策略和验证流程。' },
];
const inspirationSignals = [
  '把导航做成星图，而不是普通列表。',
  '每篇技术文章都应该留下一个可以复用的结论。',
  '界面可以炫，但正文必须安静、清晰、可读。',
];
---

<BaseLayout>
  <section class="hero section-shell">
    <div class="hero__copy reveal">
      <p class="eyebrow">Deep Space Tech Log</p>
      <h1>在更明亮的深空里，整理技术、项目与灵感。</h1>
      <p class="hero__lead">
        这里不只放技术文章，也会收纳项目实验、设计灵感、工具观察和 AI Coding 复盘。把信息从暗处拉出来，排成一张可以探索的星图。
      </p>
      <div class="hero__actions">
        <a class="button" href="/menu/">打开星际菜单</a>
        <a class="button button--ghost" href="/archive/">阅读技术传输</a>
      </div>
    </div>
    <aside class="hero__console reveal" aria-label="信号核心">
      <div class="console-topline">
        <span></span><span></span><span></span>
      </div>
      <p class="hero__console-title">Signal Core</p>
      <div class="signal-core" aria-hidden="true">
        <span class="signal-core__halo"></span>
        <span class="signal-core__planet"></span>
        <span class="signal-core__ring signal-core__ring--one"></span>
        <span class="signal-core__ring signal-core__ring--two"></span>
      </div>
      <div class="console-readout">
        <span>brightness: 86%</span>
        <span>layout: long-form</span>
        <span>menu: starmap</span>
      </div>
    </aside>
  </section>

  <section class="section-shell signal-strip reveal" aria-label="博客状态">
    {signalStats.map((stat) => (
      <div>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </div>
    ))}
  </section>

  <section class="section-shell section-block starmap-preview reveal">
    <div class="section-heading section-heading--stacked">
      <p class="eyebrow">Navigation Starmap</p>
      <h2>星际菜单</h2>
      <p>把常用入口做成一张清晰的导航星图。想写文章、看项目、找灵感或了解站点，都从这里起飞。</p>
    </div>
    <div class="starmap-grid">
      {menuCards.map((item) => (
        <a class="starmap-card" href={item.href}>
          <span class="starmap-card__status">{item.status}</span>
          <span class="starmap-card__label">{item.label}</span>
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </a>
      ))}
    </div>
    <a class="starmap-link" href="/menu/">进入完整星图 →</a>
  </section>

  <section class="section-shell section-block section-heading reveal">
    <div>
      <p class="eyebrow">Latest Transmissions</p>
      <h2>最新传输</h2>
    </div>
    <a class="text-link" href="/archive/">查看全部文章</a>
  </section>

  {latestPost ? (
    <section class="section-shell posts-showcase section-block">
      <PostCard post={latestPost} featured />
      <div class="posts-grid">
        {morePosts.slice(0, 4).map((post) => <PostCard post={post} />)}
      </div>
    </section>
  ) : (
    <section class="section-shell empty-state">
      <p>还没有文章。稍后在 <code>src/content/posts/</code> 中写下第一篇吧。</p>
    </section>
  )}

  <section id="projects" class="section-shell section-block reveal">
    <div class="section-heading section-heading--stacked">
      <p class="eyebrow">Project Dock</p>
      <h2>项目舱</h2>
      <p>把未来可以扩展的项目、组件和开发流程放在这里，让博客不只是文章仓库，也能成为个人实验室。</p>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card">
          <span>{project.type}</span>
          <h3>{project.name}</h3>
          <p>{project.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="signals" class="section-shell section-block split-panel reveal">
    <div>
      <p class="eyebrow">Signal Radio</p>
      <h2>灵感信号</h2>
      <p>短想法不一定都要变成长文章。它们可以先成为一条信号，等到足够清晰时再进入技术归档。</p>
    </div>
    <div class="signal-list">
      {inspirationSignals.map((signal, index) => (
        <p><span>0{index + 1}</span>{signal}</p>
      ))}
    </div>
  </section>

  <section class="section-shell section-block about-teaser reveal">
    <div>
      <p class="eyebrow">Mission Profile</p>
      <h2>从技术文章，到个人知识星舰。</h2>
      <p>这个站点会继续扩展项目、工具、灵感和更多互动模块，但保持静态、快速、易维护的 GitHub Pages 发布方式。</p>
    </div>
    <a class="button" href="/about/">查看任务档案</a>
  </section>
</BaseLayout>
