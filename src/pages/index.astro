---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDiaryUrl, getPublishedDiaries } from '../lib/diary';
import { getPublishedMemories } from '../lib/memories';

const diaries = await getPublishedDiaries();
const memories = await getPublishedMemories();
const latestDiary = diaries[0];
const latestMemory = memories[0];

const shortDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
const latestLogDate = latestDiary ? shortDate(latestDiary.data.pubDate) : 'NO RECORD';
const latestMemoDate = latestMemory ? shortDate(latestMemory.data.date) : 'NO RECORD';
const logCount = String(diaries.length).padStart(2, '0');
const memoCount = String(memories.length).padStart(2, '0');
---

<BaseLayout pageClass="home-page">
  <section class="hero" aria-labelledby="welcome-title">
    <div class="bunting" aria-hidden="true">
      <i style="--d: 0s"></i><i style="--d: .2s"></i><i style="--d: .4s"></i>
      <i style="--d: .1s"></i><i style="--d: .3s"></i><i style="--d: .5s"></i>
      <i style="--d: .15s"></i><i style="--d: .35s"></i>
    </div>

    <div class="hero__postcard">
      <span class="tape tape--tl" aria-hidden="true"></span>
      <span class="tape tape--br" aria-hidden="true"></span>
      <p class="hero__kicker">WELCOME TO MY SUMMER</p>
      <h1 id="welcome-title"><span class="hero__title">清夏玖的个人网站</span></h1>
      <p class="hero__lead">记录生活，也分享记忆。</p>
      <p class="hero__hand">今年夏天，也一起看海吧。</p>
      <div class="hero__actions">
        <a class="btn btn--sun" href="#modules">走进海边 <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/about/">我是谁？</a>
      </div>
      <span class="hero__stamp" aria-hidden="true">SEASIDE<br />QXJ · 2026</span>
    </div>

    <div class="hero__tags" aria-hidden="true">
      <span class="tag tag--sun">SEA 26°C</span>
      <span class="tag tag--paper">WIND 3m/s</span>
    </div>

    <a class="hero__scroll" href="#modules">
      <span>SCROLL</span>
      <i aria-hidden="true"></i>
    </a>
  </section>

  <div class="sea-ticker" aria-hidden="true">
    <div class="sea-ticker__track">
      <span class="sea-ticker__group">夏天 <i>·</i> 海风 <i>·</i> 蝉鸣 <i>·</i> 汽水 <i>·</i> 浪花 <i>·</i> 夕阳 <i>·</i> 冰棒 <i>·</i> 沙滩 <i>·</i> 夏天 <i>·</i> 海风 <i>·</i> 蝉鸣 <i>·</i> 汽水 <i>·</i></span>
      <span class="sea-ticker__group">夏天 <i>·</i> 海风 <i>·</i> 蝉鸣 <i>·</i> 汽水 <i>·</i> 浪花 <i>·</i> 夕阳 <i>·</i> 冰棒 <i>·</i> 沙滩 <i>·</i> 夏天 <i>·</i> 海风 <i>·</i> 蝉鸣 <i>·</i> 汽水 <i>·</i></span>
    </div>
  </div>

  <section id="modules" class="scene-section" aria-labelledby="modules-title">
    <header class="section-head reveal">
      <span class="chapter">CHAPTER 01</span>
      <div>
        <h2 id="modules-title">个人终端</h2>
        <p class="hand">海边的三个入口</p>
      </div>
      <span class="section-head__line" aria-hidden="true"></span>
      <span class="section-head__meta">03 SPOTS</span>
    </header>

    <nav class="postcards" aria-label="个人网站入口">
      <a class="postcard postcard--profile reveal" href="/about/">
        <span class="postcard__no">01</span>
        <span class="postcard__art" aria-hidden="true">
          <svg viewBox="0 0 64 64"><rect x="8" y="15" width="48" height="34" rx="3" /><circle cx="22" cy="29" r="6" /><path d="M14 44c2-6 14-6 16 0M38 27h11M38 34h11M38 41h7" /></svg>
        </span>
        <b>我是谁？</b>
        <em>PROFILE</em>
        <span class="postcard__go">翻开 <i aria-hidden="true">→</i></span>
        <span class="postcard__pin" aria-hidden="true"></span>
      </a>

      <a class="postcard postcard--memory reveal" href="/memories/">
        <span class="postcard__no">02</span>
        <span class="postcard__art" aria-hidden="true">
          <svg viewBox="0 0 64 64"><rect x="8" y="18" width="48" height="30" rx="3" /><circle cx="32" cy="33" r="8" /><path d="M18 18l4-6h20l4 6" /><circle cx="47" cy="25" r="2" /></svg>
        </span>
        <b>与你分享的记忆</b>
        <em>MEMORY</em>
        <span class="postcard__go">翻开 <i aria-hidden="true">→</i></span>
        <span class="postcard__pin" aria-hidden="true"></span>
      </a>

      <a class="postcard postcard--diary reveal" href="/diary/">
        <span class="postcard__no">03</span>
        <span class="postcard__art" aria-hidden="true">
          <svg viewBox="0 0 64 64"><path d="M15 10h28l6 6v38H15z" /><path d="M22 22h20M22 30h20M22 38h13" /><path d="M48 52c4-7 8-7 12 0" /></svg>
        </span>
        <b>日日不记</b>
        <em>DIARY</em>
        <span class="postcard__go">翻开 <i aria-hidden="true">→</i></span>
        <span class="postcard__pin" aria-hidden="true"></span>
      </a>
    </nav>
  </section>

  <section class="scene-section" aria-labelledby="latest-title">
    <header class="section-head reveal">
      <span class="chapter">CHAPTER 02</span>
      <div>
        <h2 id="latest-title">最近写下</h2>
        <p class="hand">夹在日记本里的那一页</p>
      </div>
      <span class="section-head__line" aria-hidden="true"></span>
      <span class="section-head__meta">{logCount} PAGES</span>
    </header>

    {latestDiary ? (
      <div class="notebook reveal">
        <span class="notebook__rings" aria-hidden="true"></span>
        <div class="notebook__page notebook__page--photo">
          {latestDiary.data.cover ? (
            <img src={latestDiary.data.cover} alt={latestDiary.data.coverAlt ?? ''} loading="lazy" />
          ) : (
            <span class="notebook__doodle" aria-hidden="true">
              <span class="doodle-sun"></span>
              <span class="doodle-sea"></span>
              <b>LOG</b>
            </span>
          )}
          <time class="notebook__date" datetime={latestDiary.data.pubDate.toISOString()}>{latestLogDate}</time>
          <span class="tape tape--photo" aria-hidden="true"></span>
        </div>
        <div class="notebook__page notebook__page--text">
          <p class="hand notebook__kicker">THIS SUMMER</p>
          <h3><a href={getDiaryUrl(latestDiary)}>{latestDiary.data.title}</a></h3>
          <p class="notebook__excerpt">{latestDiary.data.description}</p>
          <div class="tags">
            {latestDiary.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <a class="btn btn--ink" href={getDiaryUrl(latestDiary)}>读这一页 <span aria-hidden="true">→</span></a>
          <span class="notebook__scribble" aria-hidden="true">~</span>
        </div>
      </div>
    ) : (
      <div class="notebook notebook--empty reveal">
        <span class="notebook__rings" aria-hidden="true"></span>
        <div class="notebook__page notebook__page--photo">
          <span class="notebook__doodle" aria-hidden="true">
            <span class="doodle-sun"></span>
            <span class="doodle-sea"></span>
            <b>NO LOG</b>
          </span>
          <span class="notebook__date">BLANK PAGE</span>
        </div>
        <div class="notebook__page notebook__page--text">
          <p class="hand notebook__kicker">STILL WAITING</p>
          <h3>这个夏天，还没有写下什么。</h3>
          <p class="notebook__excerpt">有些日子先留白，等海风慢慢把它填满。</p>
          <a class="btn btn--ink" href="/diary/">去日记本看看 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    )}
  </section>

  <section class="scene-section" aria-labelledby="memory-title">
    <header class="section-head reveal">
      <span class="chapter">CHAPTER 03</span>
      <div>
        <h2 id="memory-title">与你分享的记忆</h2>
        <p class="hand">晒在沙滩上的照片</p>
      </div>
      <span class="section-head__line" aria-hidden="true"></span>
      <span class="section-head__meta">{memoCount} MEMOS</span>
    </header>

    {latestMemory ? (
      <div class="album reveal">
        <a class="polaroid" href="/memories/">
          <span class="polaroid__tape" aria-hidden="true"></span>
          <span class="polaroid__photo">
            <img
              src={latestMemory.data.cover ?? '/memories/assets/ocean-backdrop.jpg'}
              alt={latestMemory.data.coverAlt ?? latestMemory.data.title}
              loading="lazy"
            />
          </span>
          <span class="polaroid__caption">
            <span class="hand">MEM-001 / {latestMemoDate}</span>
            <b>{latestMemory.data.title}</b>
            <small>{latestMemory.data.description}</small>
          </span>
          <span class="polaroid__go">翻开相册 <i aria-hidden="true">→</i></span>
        </a>
        <div class="album__note">
          <span class="hand">夏天会过去，照片会留下来。</span>
          <span class="album__stamp">{memoCount} MEMORIES</span>
        </div>
      </div>
    ) : (
      <div class="album album--empty reveal">
        <div class="empty-letter">
          <span class="hand">还没有收藏的记忆。</span>
          <p>等第一张照片被海浪送回来。</p>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
