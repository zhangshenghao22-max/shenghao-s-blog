---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPostsByCategory } from '../lib/posts';

const postsUrl = 'https://github.com/zhangshenghao22-max/shenghao-s-blog/tree/main/src/content/posts';
const lifePosts = await getPostsByCategory('life');
const techPosts = await getPostsByCategory('tech');
const entryItems = [
  { href: '#life', emoji: '🌤️', title: '生活文章', text: '咖啡、散步、书桌和日常小片段。' },
  { href: '#tech', emoji: '💻', title: '技术板块', text: '前端工程、Astro、自动化和 AI 复盘。' },
  { href: postsUrl, emoji: '✍️', title: '发表文章', text: '在 GitHub 新增 Markdown，推送后自动部署。' },
  { href: '#profile', emoji: '☺️', title: '个人简介', text: '关于我、兴趣关键词和联系方式。' },
  { href: '#inspiration', emoji: '✨', title: '灵感橱窗', text: '短想法、配色、工具和未来小功能。' },
  { href: '/archive/', emoji: '📚', title: '全部归档', text: '按时间浏览所有生活和技术文章。' },
];
const moodCapsules = [
  { icon: '☕', label: '今日状态', text: '慢热但在线' },
  { icon: '🎧', label: '正在听', text: 'lo-fi / city pop' },
  { icon: '🌱', label: '最近喜欢', text: '清爽界面和小贴纸' },
  { icon: '✨', label: '当前目标', text: '把灵感变成作品' },
];
const inspirationItems = [
  { title: '小组件日记', text: '把每日心情做成像 iOS widget 一样的小卡片。' },
  { title: '灵感抽屉', text: '收集一句话想法、配色、排版和喜欢的交互。' },
  { title: '温柔工具箱', text: '整理让开发更顺手的小工具和工作流。' },
];
---

<BaseLayout>
  <section class="hero section-shell">
    <div class="hero__copy reveal">
      <p class="eyebrow">Life & Tech Studio</p>
      <h1>把生活的柔光，和技术的秩序放在同一个岛屿。</h1>
      <p class="hero__lead">
        这里是我的个人博客：分享生活里的小确幸，也记录技术文章、前端实验和 AI Coding 复盘。整体保持简约明朗，但保留一点可爱和惊喜。
      </p>
      <div class="hero__actions">
        <a class="button" href="#entry">探索入口</a>
        <a class="button button--ghost" href="#life">看最新文章</a>
      </div>
    </div>
    <aside class="hero-card reveal" aria-label="今日小岛状态">
      <span class="sticker sticker--sun">☀️</span>
      <p class="hero-card__label">Today on the island</p>
      <h2>清爽、明亮、有一点点可爱。</h2>
      <p>生活记录负责柔软，技术文章负责清晰，灵感橱窗负责让页面保持好奇心。</p>
      <div class="mini-device" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
    </aside>
  </section>

  <div class="section-divider section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="entry" class="section-shell quick-entry reveal" aria-label="快速入口总览">
    <div class="quick-entry__header">
      <p class="eyebrow">Quick Entrance</p>
      <h2>你想先去哪里？</h2>
      <p>把常用入口放在第一屏之后，像一组轻盈的小组件，打开就能找到方向。</p>
    </div>
    <div class="entry-grid">
      {entryItems.map((item) => (
        <a class="entry-card" href={item.href}>
          <span>{item.emoji}</span>
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </a>
      ))}
    </div>
  </section>

  <div class="section-divider section-divider--soft section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section class="section-shell mood-strip reveal" aria-label="心情胶囊">
    {moodCapsules.map((item) => (
      <article class="mood-pill">
        <span>{item.icon}</span>
        <div>
          <strong>{item.label}</strong>
          <p>{item.text}</p>
        </div>
      </article>
    ))}
  </section>

  <div class="section-divider section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="life" class="section-shell section-block reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Daily Notes</p>
        <h2>生活文章</h2>
      </div>
      <p>咖啡、散步、书桌、天气和那些让日子变亮的小事。</p>
    </div>
    <div class="posts-grid posts-grid--life">
      {lifePosts.slice(0, 3).map((post, index) => <PostCard post={post} featured={index === 0} />)}
    </div>
  </section>

  <div class="section-divider section-divider--soft section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="tech" class="section-shell section-block reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Tech Notes</p>
        <h2>技术板块</h2>
      </div>
      <a class="text-link" href="/archive/">全部文章</a>
    </div>
    <div class="posts-grid posts-grid--tech">
      {techPosts.slice(0, 3).map((post, index) => <PostCard post={post} featured={index === 0} />)}
    </div>
  </section>

  <div class="section-divider section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="profile" class="section-shell section-block profile-panel reveal">
    <div>
      <p class="eyebrow">Profile</p>
      <h2>你好，我在这里记录生活，也整理技术。</h2>
      <p>
        我喜欢把复杂的问题拆清楚，也喜欢把普通的一天写得更有光。这个博客会慢慢变成我的生活相册、技术笔记、灵感抽屉和个人作品入口。
      </p>
      <div class="profile-actions">
        <a class="button" href="/about/">查看个人简介</a>
        <a class="button button--ghost" href="https://github.com/zhangshenghao22-max">GitHub</a>
      </div>
    </div>
    <div class="profile-card" aria-label="个人关键词">
      <span class="avatar-bubble">☺</span>
      <dl>
        <div><dt>关键词</dt><dd>前端 / 生活记录 / AI Coding</dd></div>
        <div><dt>喜欢</dt><dd>简洁界面、温柔配色、可爱细节</dd></div>
        <div><dt>正在做</dt><dd>把博客打磨成个人灵感空间</dd></div>
      </dl>
    </div>
  </section>

  <div class="section-divider section-divider--soft section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="inspiration" class="section-shell section-block reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Inspiration Shelf</p>
        <h2>灵感橱窗</h2>
      </div>
      <a class="text-link" href="/menu/">打开灵感菜单</a>
    </div>
    <div class="inspiration-grid">
      {inspirationItems.map((item) => (
        <article class="inspiration-card">
          <span>✦</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
