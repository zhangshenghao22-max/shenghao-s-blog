---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedDiaries } from '../lib/diary';
import { getPublishedMemories, formatMemoryDate } from '../lib/memories';

const diaries = await getPublishedDiaries();
const memories = await getPublishedMemories();
const latestDiary = diaries[0];
const latestMemory = memories[0];
const today = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }).format(new Date());
---

<BaseLayout pageClass="home-page">
  <div class="ark-home section-shell">
    <section class="ark-hero reveal" aria-labelledby="welcome-title">
      <img class="ark-hero__bg" src="/images/arknights/theme-forest.png" alt="沉浸式主题视觉" loading="eager" fetchpriority="high" decoding="async" />
      <div class="ark-hero__veil" aria-hidden="true"></div>
      <div class="ark-hero__frame" aria-hidden="true"></div>
      <div class="ark-hero__copy">
        <span class="ark-hero__mark" aria-hidden="true">清</span>
        <h1 id="welcome-title">欢迎来到清夏玖的个人网站</h1>
        <p>记录生活，也分享记忆。</p>
        <a class="ark-hero__enter" href="#modules">进入个人终端 <span aria-hidden="true">↘</span></a>
      </div>
      <div class="ark-hero__pager" aria-hidden="true"><span class="is-active"></span><span></span><span></span></div>
      <span class="ark-hero__edge" aria-hidden="true"></span>
    </section>

    <section id="modules" class="ark-module-section section-space" aria-labelledby="modules-title">
      <div class="ark-heading reveal"><span class="ark-heading__rule" aria-hidden="true"></span><h2 id="modules-title">个人终端</h2></div>
      <nav class="ark-nav" aria-label="个人网站入口">
        <a class="ark-nav__tile reveal" href="/about/"><span class="ark-nav__icon ark-nav__icon--profile" aria-hidden="true"></span><strong>我是谁？</strong></a>
        <a class="ark-nav__tile reveal" href="/memories/"><span class="ark-nav__icon ark-nav__icon--memory" aria-hidden="true"></span><strong>与你分享的记忆</strong></a>
        <a class="ark-nav__tile reveal" href="/diary/"><span class="ark-nav__icon ark-nav__icon--diary" aria-hidden="true"></span><strong>日日不记</strong></a>
        <a class="ark-nav__tile reveal" href="/admin/"><span class="ark-nav__icon ark-nav__icon--write" aria-hidden="true"></span><strong>写下日记</strong></a>
      </nav>
    </section>

    <section class="ark-hud section-space reveal" aria-label="个人终端信息">
      <div class="ark-clock"><strong>{today}</strong><span>清夏玖的个人记录</span></div>
      <div class="ark-hud__signal"><span aria-hidden="true"></span><b>记忆持续更新</b></div>
    </section>

    {latestDiary && <section class="ark-record section-space" aria-labelledby="latest-title">
      <div class="ark-heading ark-heading--split reveal"><div><span class="ark-heading__rule" aria-hidden="true"></span><h2 id="latest-title">最近写下</h2></div><a class="ark-link" href="/diary/">查看全部 <span aria-hidden="true">↗</span></a></div>
      <div class="ark-record__grid">
        <div class="ark-record__feature reveal"><PostCard diary={latestDiary} featured /></div>
        {diaries.slice(1, 3).map((diary) => <div class="ark-record__side reveal"><PostCard diary={diary} /></div>)}
      </div>
    </section>}

    {latestMemory && <section class="ark-memory section-space reveal" aria-labelledby="latest-memory-title">
      <a class="ark-memory__image" href="/memories/"><img src={latestMemory.data.cover ?? '/images/arknights/theme-forest.png'} alt={latestMemory.data.coverAlt ?? '最近的一段记忆'} loading="lazy" /></a>
      <div class="ark-memory__copy"><time datetime={latestMemory.data.date.toISOString()}>{formatMemoryDate(latestMemory.data.date)}</time><h2 id="latest-memory-title">{latestMemory.data.title}</h2><p>{latestMemory.data.description}</p><a class="ark-link" href="/memories/">打开记忆 <span aria-hidden="true">↗</span></a></div>
    </section>}
  </div>
</BaseLayout>
