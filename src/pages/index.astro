---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPostsByCategory } from '../lib/posts';

const adminUrl = '/admin/';
const lifePosts = await getPostsByCategory('life');
const techPosts = await getPostsByCategory('tech');

const entryItems = [
  { href: '/life/', code: 'L-01', title: '生活档案', text: '日常、散步、照片和心情碎片。', status: 'RECORD' },
  { href: '/tech/', code: 'T-02', title: '技术记录', text: 'Astro、前端工程、AI Coding 与复盘。', status: 'BUILD' },
  { href: adminUrl, code: 'P-03', title: '发表文章', text: '进入后台写 Markdown，发布后自动上线。', status: 'CMS' },
  { href: '/about/', code: 'O-04', title: '个人简介', text: '查看我的身份档案、兴趣和联系方式。', status: 'PROFILE' },
  { href: '/inspiration/', code: 'I-05', title: '灵感仓库', text: '短句、点子、设计片段和未来功能。', status: 'INTEL' },
  { href: '/archive/', code: 'A-06', title: '全部归档', text: '按时间检索所有已发布文章。', status: 'ARCHIVE' },
];

const moodCapsules = [
  { code: 'SYS', label: '终端状态', text: 'ONLINE / 记录开放' },
  { code: 'BGM', label: '背景音', text: 'lo-fi / city pop / 键盘声' },
  { code: 'OBJ', label: '当前任务', text: '把博客改成更锋利的档案系统' },
  { code: 'LOG', label: '记录倾向', text: '生活温度 + 技术秩序' },
];

const terminalModules = [
  { code: 'SCAN', title: '扫描线', text: '页面顶部保留一条轻量进度光带，像终端正在读取档案。' },
  { code: 'GRID', title: '工业网格', text: '用细网格、角标和编号建立战术界面的秩序感。' },
  { code: 'CMS', title: '发布后台', text: '只有白名单 GitHub 账号能进入后台发布文章。' },
  { code: 'ASSET', title: '素材槽位', text: '可在 public/images/arknights/hero.png 放入授权素材。' },
];

const inspirationItems = [
  { title: '档案边角', text: '每个卡片都像被贴上编号的资料页，信息更清晰。' },
  { title: '警示橙线', text: '用少量橙色做引导，不让深色页面变得沉闷。' },
  { title: '个人终端', text: '把生活、技术、灵感和后台都收进同一个控制台。' },
];
---

<BaseLayout>
  <section class="hero section-shell">
    <div class="hero__copy reveal">
      <p class="eyebrow">OPERATION FILE / PERSONAL TERMINAL</p>
      <h1>操全世界</h1>
      <p class="hero__lead">
        这里是清夏玖的个人记录终端：生活档案负责保存日常温度，技术记录负责整理工程经验，灵感仓库负责收纳突然冒出来的想法。整体改成高对比战术面板，少一点柔软，多一点锋利和秩序。
      </p>
      <div class="hero__actions">
        <a class="button" href="#entry">打开快速索引</a>
        <a class="button button--ghost" href="/tech/">读取技术记录</a>
      </div>
      <div class="hero__meta" aria-label="终端状态">
        <span>SECURITY: OWNER ONLY</span>
        <span>DEPLOY: GITHUB PAGES</span>
        <span>CMS: ACTIVE</span>
      </div>
    </div>

    <aside class="hero-card reveal" aria-label="个人记录终端状态">
      <div class="hero-card__top">
        <span>RI-09 / OPERATOR BLOG</span>
        <span>STATUS ACTIVE</span>
      </div>
      <div class="terminal-sigil" aria-label="授权素材预留位，缺省时显示原创终端几何图形">
        <span>QX9</span>
        <i></i>
        <b>TACTICAL ARCHIVE</b>
      </div>
      <p class="hero-card__label">ARCHIVE CHANNEL</p>
      <h2>Life records / Tech files / Intel shelf</h2>
      <p>没有提供授权素材时，这里会自动显示原创几何终端占位；后续把图片放进 <code>/public/images/arknights/hero.png</code> 即可启用。</p>
    </aside>
  </section>

  <div class="section-divider section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="entry" class="section-shell quick-entry reveal" aria-label="快速索引面板">
    <div class="quick-entry__header">
      <p class="eyebrow">TACTICAL INDEX</p>
      <h2>快速索引面板</h2>
      <p>入口页已移除，所有主要功能直接收拢在首页终端面板里。选择一个编号，即可跳转到对应的独立页面或后台。</p>
    </div>
    <div class="entry-grid">
      {entryItems.map((item) => (
        <a class="entry-card" href={item.href} data-status={item.status}>
          <span>{item.code}</span>
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </a>
      ))}
    </div>
  </section>

  <div class="section-divider section-divider--soft section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section class="section-shell mood-strip reveal" aria-label="终端状态条">
    {moodCapsules.map((item) => (
      <article class="mood-pill">
        <span>{item.code}</span>
        <div>
          <strong>{item.label}</strong>
          <p>{item.text}</p>
        </div>
      </article>
    ))}
  </section>

  <div class="section-divider section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="life" class="section-shell section-block reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LIFE RECORDS</p>
        <h2>生活档案</h2>
      </div>
      <p>日常、天气、书桌、散步和一些只有当时才会出现的细节。</p>
    </div>
    <div class="posts-grid posts-grid--life">
      {lifePosts.slice(0, 3).map((post, index) => <PostCard post={post} featured={index === 0} />)}
    </div>
  </section>

  <div class="section-divider section-divider--soft section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="tech" class="section-shell section-block reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">TECH FILES</p>
        <h2>技术记录</h2>
      </div>
      <a class="text-link" href="/tech/">打开技术页</a>
    </div>
    <div class="posts-grid posts-grid--tech">
      {techPosts.slice(0, 3).map((post, index) => <PostCard post={post} featured={index === 0} />)}
    </div>
  </section>

  <div class="section-divider section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="profile" class="section-shell section-block profile-panel reveal">
    <div>
      <p class="eyebrow">OPERATOR PROFILE</p>
      <h2>个人简介 / 作战档案</h2>
      <p>
        我会把这里当成长期更新的个人终端：写生活，整理技术，也记录一些灵感、工具和页面实验。它不只是一组文章列表，而是一份持续扩展的个人档案。
      </p>
      <div class="profile-actions">
        <a class="button" href="/about/">查看个人简介</a>
        <a class="button button--ghost" href="https://github.com/zhangshenghao22-max">GitHub</a>
      </div>
    </div>
    <div class="profile-card" aria-label="个人关键词">
      <span class="avatar-bubble">RI</span>
      <dl>
        <div><dt>关键词</dt><dd>前端 / 生活记录 / AI Coding</dd></div>
        <div><dt>偏好</dt><dd>高对比界面、清晰结构、编号档案</dd></div>
        <div><dt>正在做</dt><dd>把博客打磨成可长期扩展的个人终端</dd></div>
      </dl>
    </div>
  </section>

  <div class="section-divider section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section class="section-shell section-block toy-shelf reveal" aria-label="终端组件">
    <div class="section-heading">
      <div>
        <p class="eyebrow">TERMINAL MODULES</p>
        <h2>终端组件</h2>
      </div>
      <p>保留轻量视觉反馈，不恢复夸张动效；用小型模块让页面更像一块正在运行的档案屏。</p>
    </div>
    <div class="toy-grid">
      {terminalModules.map((item) => (
        <article class="toy-card">
          <span>{item.code}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <div class="section-divider section-divider--soft section-shell" aria-hidden="true"><span></span><span></span><span></span></div>

  <section id="inspiration" class="section-shell section-block reveal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">INTEL SHELF</p>
        <h2>灵感仓库</h2>
      </div>
      <a class="text-link" href="/inspiration/">打开灵感页</a>
    </div>
    <div class="inspiration-grid">
      {inspirationItems.map((item) => (
        <article class="inspiration-card">
          <span>//</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
