---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedMemories, formatMemoryDate } from '../lib/memories';
const memories = await getPublishedMemories();
---

<BaseLayout title="与你分享的记忆" description="清夏玖珍藏的照片与视频。" pageClass="memories-page">
  <section class="page-heading section-shell reveal"><h1>与你分享的记忆</h1><p>一些舍不得忘记的瞬间。</p></section>
  <div class="section-shell memories-list">
    {memories.map((memory) => <section class="memory-group section-space">
      <header class="memory-group__heading reveal"><time datetime={memory.data.date.toISOString()}>{formatMemoryDate(memory.data.date)}</time><h2>{memory.data.title}</h2><p>{memory.data.description}</p></header>
      <div class="memory-wall">{memory.data.items.map((item, index) => <figure class:list={["memory-item", "reveal", { 'memory-item--wide': index === 0 }]}>
        {item.type === 'image' ? <a href={item.src} data-lightbox><img src={item.src} alt={item.alt ?? memory.data.title} loading="lazy" /></a> : <video src={item.src} poster={item.poster} controls playsinline preload="metadata" aria-label={item.alt ?? item.caption ?? memory.data.title}></video>}
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>)}</div>
    </section>)}
    {!memories.length && <p class="empty-state">还没有收藏的记忆。</p>}
  </div>
  <dialog class="lightbox" aria-label="照片预览"><button class="lightbox__close" type="button" aria-label="关闭照片">×</button><img src="" alt="" /></dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
    const preview = dialog?.querySelector<HTMLImageElement>('img');
    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (!dialog || !preview) return;
        event.preventDefault();
        preview.src = link.href;
        preview.alt = link.querySelector('img')?.alt ?? '';
        dialog.showModal();
      });
    });
    dialog?.querySelector('button')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  </script>
</BaseLayout>
