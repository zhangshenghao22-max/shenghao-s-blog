---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { formatPostDate, getPostSlug, getPostUrl, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const posts = await getPublishedPosts();
const currentIndex = posts.findIndex((item) => item.id === post.id);
const previousPost = posts[currentIndex + 1];
const nextPost = posts[currentIndex - 1];
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} pageClass="article-page">
  <article class="article-shell section-shell reveal">
    <header class="article-header">
      <p class="eyebrow">{formatPostDate(post.data.pubDate)}</p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <ul class="tag-list tag-list--center" aria-label="文章标签">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
      {post.data.cover && <img class="article-cover" src={post.data.cover} alt={post.data.coverAlt ?? ''} />}
    </header>

    <div class="article-content">
      <Content />
    </div>
  </article>

  <nav class="post-nav section-shell" aria-label="文章导航">
    {previousPost ? (
      <a class="post-nav__item" href={getPostUrl(previousPost)}>
        <span>上一篇</span>
        {previousPost.data.title}
      </a>
    ) : <span></span>}
    {nextPost ? (
      <a class="post-nav__item post-nav__item--next" href={getPostUrl(nextPost)}>
        <span>下一篇</span>
        {nextPost.data.title}
      </a>
    ) : <span></span>}
  </nav>
</BaseLayout>
